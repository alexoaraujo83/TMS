# Public API origin consumed by the browser and by the TMS Web server-side proxy.
# Example: https://<tms-api-production-host>
NEXT_PUBLIC_API_BASE_URL=

# Auth0 tenant / issuer.
AUTH0_ISSUER_BASE_URL=https://tms-platform.us.auth0.com

# The canonical public origin of this TMS Web deployment.
# Use the real Vercel production URL or configured custom domain; do not use
# the tenant-claim namespace (https://tms.tms/claims/tenant_id) here.
AUTH0_BASE_URL=

# 32+ byte random secret used to encrypt the TMS Web session cookie.
AUTH0_SECRET=

# TMS Web Auth0 Regular Web Application client ID.
AUTH0_CLIENT_ID=

# TMS Web Auth0 Regular Web Application client secret. Never commit the value.
AUTH0_CLIENT_SECRET=

# Production TMS API audience. Keep environment-specific in other environments.
AUTH0_AUDIENCE=urn:tms:api:production
