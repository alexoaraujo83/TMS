# Public API origin consumed by the browser and by the TMS Web server-side proxy.
# Example: https://<tms-api-production-host>
NEXT_PUBLIC_API_BASE_URL=

# Auth0 tenant domain.
AUTH0_DOMAIN=tms-platform.us.auth0.com

# Auth0 issuer used by the Next.js Auth0 SDK.
AUTH0_ISSUER_BASE_URL=https://tms-platform.us.auth0.com/

# Auth0 JWKS endpoint used by the TMS API verifier.
AUTH0_JWKS_URL=https://tms-platform.us.auth0.com/.well-known/jwks.json

# Auth0 Regular Web Application client ID.
AUTH0_CLIENT_ID=

# Auth0 Regular Web Application client secret. Never commit the value.
AUTH0_CLIENT_SECRET=

# 32+ byte random secret used to encrypt the TMS Web session cookie.
AUTH0_SECRET=

# Canonical public origin of this TMS Web deployment.
# For dynamic Vercel previews this can be omitted; keep production explicit.
APP_BASE_URL=

# Production TMS API audience.
AUTH0_AUDIENCE=urn:tms:api:production
