NODE_ENV=development
APP_ENV=local
APP_NAME=tms
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://tms:tms@localhost:5432/tms_dev
DATABASE_DIRECT_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=urn:tms:api:development
AUTH0_ISSUER_BASE_URL=https://YOUR_DOMAIN.auth0.com/
AUTH0_JWKS_URL=
TENANT_HEADER=x-tenant-id
WORKER_ENABLED=false
WORKER_CONCURRENCY=5
LOG_LEVEL=info
BACKUP_RETENTION_DAYS=14

# Deployment environments: local | development | staging | production
# Auth0 audiences:
# development = urn:tms:api:development
# staging = urn:tms:api:staging
# production = urn:tms:api:production
# Neon branches: default=production, development=development, staging=staging
# CORS_ALLOWED_ORIGINS must contain explicit browser origins separated by commas.
# BACKUP_RETENTION_DAYS controls deletion of verified backup objects older than this many days.
# Do not use '*' and never commit populated secrets or production connection strings.
