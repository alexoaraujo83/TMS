NODE_ENV=development
APP_ENV=local
APP_NAME=tms
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgresql://tms:tms@localhost:5432/tms_dev
DATABASE_DIRECT_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=urn:nexora:tms:api:development
AUTH0_ISSUER_BASE_URL=https://YOUR_DOMAIN.auth0.com/
AUTH0_JWKS_URL=
TENANT_HEADER=x-tenant-id
WORKER_ENABLED=false
WORKER_CONCURRENCY=5
LOG_LEVEL=info

# Deployment environments: local | development | staging | production
# Auth0 audiences:
# development = urn:nexora:tms:api:development
# staging = urn:nexora:tms:api:staging
# production = urn:nexora:tms:api:production
# Neon branches: default=production, development=development, staging=staging
# Never commit populated secrets or production connection strings.
